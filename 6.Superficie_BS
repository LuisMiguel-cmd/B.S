import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import norm
from mpl_toolkits.mplot3d import Axes3D


# =========================================================
# BLACK-SCHOLES
# =========================================================

def black_scholes_call(S, K, T, r, sigma):
    """
    Preço de uma opção de compra (Call) Europeia.
    """

    T = np.maximum(T, 1e-6)

    d1 = (
        np.log(S / K)
        + (r + 0.5 * sigma**2) * T
    ) / (sigma * np.sqrt(T))

    d2 = d1 - sigma * np.sqrt(T)

    return (
        S * norm.cdf(d1)
        - K * np.exp(-r * T) * norm.cdf(d2)
    )


# =========================================================
# PARÂMETROS
# =========================================================

K = 100
r = 0.05
sigma = 0.20


# =========================================================
# MALHA
# =========================================================

s_range = np.linspace(50, 150, 300)
t_range = np.linspace(0.01, 2.0, 300)

S, T = np.meshgrid(s_range, t_range)

V = black_scholes_call(S, K, T, r, sigma)


# =========================================================
# FIGURA
# =========================================================

fig = plt.figure(figsize=(14, 10))

ax = fig.add_subplot(111, projection='3d')


# =========================================================
# SUPERFÍCIE
# =========================================================

surf = ax.plot_surface(
    S,
    T,
    V,
    cmap='viridis',
    linewidth=0,
    antialiased=True,
    shade=True,
    alpha=0.92
)


# =========================================================
# CURVAS DE NÍVEL
# =========================================================

ax.contour(
    S,
    T,
    V,
    zdir='z',
    offset=0,
    levels=15,
    cmap='viridis'
)


# =========================================================
# CURVA DESTACADA S = K
# =========================================================

T_curve = np.linspace(0.01, 2.0, 600)

S_curve = np.full_like(T_curve, K)

V_curve = black_scholes_call(
    S_curve,
    K,
    T_curve,
    r,
    sigma
)

ax.plot(
    S_curve,
    T_curve,
    V_curve,
    color='red',
    linewidth=4,
    label=r'$S = K = 100$'
)

# Pontos inicial e final da curva

ax.scatter(
    S_curve[0],
    T_curve[0],
    V_curve[0],
    color='black',
    s=80
)

ax.scatter(
    S_curve[-1],
    T_curve[-1],
    V_curve[-1],
    color='black',
    s=80
)


# =========================================================
# TÍTULO E EIXOS
# =========================================================

ax.set_title(
    'Superfície de Preço da Opção Call - Modelo de Black-Scholes',
    fontsize=16,
    pad=20
)

ax.set_xlabel(
    'Preço do Ativo (S)',
    fontsize=12,
    labelpad=12
)

ax.set_ylabel(
    'Tempo até o Vencimento (T)',
    fontsize=12,
    labelpad=12
)

ax.set_zlabel(
    'Preço da Opção (V)',
    fontsize=12,
    labelpad=12
)


# =========================================================
# GRID
# =========================================================

ax.grid(True)

ax.xaxis._axinfo["grid"]['linewidth'] = 0.8
ax.yaxis._axinfo["grid"]['linewidth'] = 0.8
ax.zaxis._axinfo["grid"]['linewidth'] = 0.8

ax.xaxis._axinfo["grid"]['linestyle'] = '--'
ax.yaxis._axinfo["grid"]['linestyle'] = '--'
ax.zaxis._axinfo["grid"]['linestyle'] = '--'


# =========================================================
# LIMITES
# =========================================================

ax.set_zlim(0, np.max(V))


# =========================================================
# VISUALIZAÇÃO
# =========================================================

ax.view_init(
    elev=28,
    azim=-130
)


# =========================================================
# LEGENDA
# =========================================================

ax.legend(
    loc='upper left',
    fontsize=11
)


# =========================================================
# BARRA DE CORES
# =========================================================

cbar = fig.colorbar(
    surf,
    shrink=0.6,
    aspect=20,
    pad=0.1
)

cbar.set_label(
    'Preço da Opção',
    fontsize=11
)


# =========================================================
# SALVAR
# =========================================================

plt.savefig(
    "superficie_black_scholes_ATM.png",
    dpi=300,
    bbox_inches='tight'
)


# =========================================================
# MOSTRAR
# =========================================================

plt.show()

