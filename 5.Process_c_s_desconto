import numpy as np
import matplotlib.pyplot as plt

# Parâmetros
T = 1.0
N = 500
dt = T / N
t = np.linspace(0, T, N + 1)

S0 = 1.0
mu = 0.1
r = 0.1
sigma = 0.3

np.random.seed(2)

dW = np.sqrt(dt) * np.random.randn(N)
W = np.concatenate(([0], np.cumsum(dW)))

S = S0 * np.exp((mu - 0.5 * sigma**2) * t + sigma * W)
S_discounted = np.exp(-r * t) * S

plt.figure()
plt.plot(t, S, label=r"$S_t$")
plt.plot(t, S_discounted, label=r"$e^{-rt}S_t$")
plt.xlabel("Tempo")
plt.ylabel("Valor do processo")
plt.legend()
plt.title("Processo original e processo descontado")
plt.show()
