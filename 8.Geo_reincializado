import numpy as np
import pandas as pd
import matplotlib.pyplot as plt


# =========================================================
# MOVIMENTO BROWNIANO GEOMÉTRICO
# SOB MEDIDA NEUTRA AO RISCO
# =========================================================

def simulate_gbm_step(S, dt, r, sigma):
    """
    Simula um passo do Movimento Browniano Geométrico
    utilizando a taxa livre de risco.
    """

    epsilon = np.random.normal()

    S_next = S * np.exp(
        (r - 0.5 * sigma**2) * dt
        + sigma * np.sqrt(dt) * epsilon
    )

    return S_next


# =========================================================
# PARÂMETROS
# =========================================================

S0 = 48.02

r = 0.05          # taxa livre de risco
sigma = 0.20      # volatilidade

dt = 1 / 12       # passo mensal

months_2years = 24
months_extra = 12


# =========================================================
# PRIMEIRA SIMULAÇÃO (2 ANOS)
# =========================================================

S_values_2years = [S0]

current_S = S0

for month in range(months_2years):

    current_S = simulate_gbm_step(
        current_S,
        dt,
        r,
        sigma
    )

    S_values_2years.append(current_S)


# =========================================================
# VALOR NO MÊS 12
# =========================================================

S12 = S_values_2years[12]

print("=" * 60)
print(f"Valor de S12 = {S12:.2f}")
print("=" * 60)


# =========================================================
# SEGUNDA SIMULAÇÃO
# (REINICIADA A PARTIR DE S12)
# =========================================================

S_values_restart = [S12]

current_S = S12

for month in range(months_extra):

    current_S = simulate_gbm_step(
        current_S,
        dt,
        r,
        sigma
    )

    S_values_restart.append(current_S)


# =========================================================
# EIXOS TEMPORAIS
# =========================================================

months_main = list(range(0, 25))

months_restart = list(range(12, 25))


# =========================================================
# DATAFRAMES
# =========================================================

df_main = pd.DataFrame({
    "Mes": months_main,
    "S_Original": S_values_2years
})

df_restart = pd.DataFrame({
    "Mes": months_restart,
    "S_Reiniciado": S_values_restart
})


# =========================================================
# EXIBIR TABELAS
# =========================================================

print("\nTrajetória Original:")
print(df_main)

print("\nTrajetória Reiniciada:")
print(df_restart)


# =========================================================
# GRÁFICO COMPARATIVO
# =========================================================

plt.figure(figsize=(16, 8))


# ---------------------------------------------------------
# Trajetória original de 2 anos
# ---------------------------------------------------------

plt.plot(
    months_main,
    S_values_2years,
    marker='o',
    linewidth=2.5,
    label='Trajetória Original (2 anos)'
)


# ---------------------------------------------------------
# Trajetória reiniciada em S12
# ---------------------------------------------------------

plt.plot(
    months_restart,
    S_values_restart,
    marker='s',
    linestyle='--',
    linewidth=2.5,
    label='Nova trajetória iniciada em S12'
)


# ---------------------------------------------------------
# Destacar o instante S12
# ---------------------------------------------------------

plt.axvline(
    x=12,
    color='red',
    linestyle=':',
    linewidth=2,
    label='Reinicialização em S12'
)

plt.scatter(
    12,
    S12,
    s=140,
    zorder=5,
    label=f'S12 = {S12:.2f}'
)


# =========================================================
# CONFIGURAÇÕES VISUAIS
# =========================================================

plt.title(
    'Simulação do Movimento Browniano Geométrico\n'
    'com Reinicialização da Trajetória em S12',
    fontsize=16
)

plt.xlabel('Mês')

plt.ylabel('Preço do Ativo')

plt.xticks(range(0, 25))

plt.grid(True, linestyle='--', alpha=0.6)

plt.legend()

plt.tight_layout()


# =========================================================
# SALVAR FIGURA
# =========================================================

plt.savefig("gbm_reinicializacao_risco_neutro.png")

plt.show()


# =========================================================
# EXPORTAR CSV
# =========================================================

df_main.to_csv(
    "trajetoria_original_risco_neutro.csv",
    index=False
)

df_restart.to_csv(
    "trajetoria_reiniciada_risco_neutro.csv",
    index=False
)


# =========================================================
# MENSAGEM FINAL
# =========================================================

print("\nArquivos gerados:")
print(" - gbm_reinicializacao_risco_neutro.png")
print(" - trajetoria_original_risco_neutro.csv")
print(" - trajetoria_reiniciada_risco_neutro.csv")
